# ⚠️ SECURITY WARNING ⚠️
# This file contains sensitive credentials and should NEVER be committed to Git
# Add this file to .gitignore immediately

# Server Configuration
NODE_ENV=production
PORT=3001

# MongoDB Connection
# Update the password and connection string for production
MONGODB_URI=mongodb+srv://application:Newpass123@cluster0.5cmxzxj.mongodb.net/ldoia_database?retryWrites=true&w=majority&appName=Cluster0


# Frontend URLs
# Update these after deploying to Netlify
FRONTEND_URL=https://ldoia.com
ADMIN_FRONTEND_URL=https://ldoia.com/superadmin

# JWT & Security
# IMPORTANT: Generate a new secret for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_SECURE_JWT_SECRET_REPLACE_THIS

# SMS/OTP Configuration
FAST2SMS_API_KEY=Ra3Weq1mDp27byivuZdcr0MEf5Lk8XK64sUPwHOBgSxJIhzGYN3SLbFvqcOoJZ0sE8Q1VBzCGAuDyr5f
FAST2SMS_SENDER_ID=LDOIA
OTP_PROVIDER=fast2sms
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Email Configuration
# Update with your production email credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_app_specific_password

# Payment Gateway - Razorpay
# IMPORTANT: Replace test keys with LIVE keys for production
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
PAYMENT_CURRENCY=INR

# File Upload Settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpeg,jpg,png,pdf
UPLOAD_DIR=/tmp/uploads

# Database (PostgreSQL - if you're using it)
DB_HOST=your_postgres_host
DB_PORT=5432
DB_NAME=ldoia_applications
DB_USER=ldoia_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
